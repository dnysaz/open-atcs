# ===== ATCS TV — contoh konfigurasi =====
# Salin file ini menjadi server/.env lalu isi nilainya.
# JANGAN commit server/.env (sudah di .gitignore).

# API key Google Gemini (wajib untuk fitur analisis lalu lintas)
GOOGLE_API_KEY=

# Model Gemini yang dipakai (kuota per model terpisah)
GEMINI_MODEL=gemini-3.6-flash

# Durasi capture video analisis dalam detik (15/30/60)
CAPTURE_SECONDS=30
