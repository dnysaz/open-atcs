---
interface Props {
  kind?: 'card' | 'compact' | 'player' | 'lines';
}

const { kind = 'card' } = Astro.props;
const block = 'animate-pulse rounded-full bg-ink4/70';
---

{
  kind === 'card' ? (
    <div class="block" aria-hidden="true">
      <div class="aspect-video animate-pulse rounded-xl bg-ink4/70"></div>
      <div class="mt-3 flex gap-3">
        <div class="h-9 w-9 shrink-0 animate-pulse rounded-full bg-ink4/70"></div>
        <div class="flex-1 space-y-2 pt-1">
          <div class={`${block} h-3 w-5/6`}></div>
          <div class={`${block} h-3 w-2/3`}></div>
        </div>
      </div>
    </div>
  ) : kind === 'compact' ? (
    <div class="flex gap-3" aria-hidden="true">
      <div class="aspect-video w-40 shrink-0 animate-pulse rounded-lg bg-ink4/70 sm:w-44"></div>
      <div class="flex-1 space-y-2 pt-1">
        <div class={`${block} h-3 w-5/6`}></div>
        <div class={`${block} h-3 w-2/3`}></div>
      </div>
    </div>
  ) : kind === 'player' ? (
    <div class="aspect-video animate-pulse rounded-xl bg-ink4/70" aria-hidden="true"></div>
  ) : (
    <div class="space-y-2" aria-hidden="true">
      <div class={`${block} h-5 w-1/2`}></div>
      <div class={`${block} h-3 w-3/4`}></div>
      <div class={`${block} h-3 w-1/3`}></div>
    </div>
  )
}
