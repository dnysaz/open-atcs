---
import Icon from './Icon.astro';
import { categories, categoryIcon, offlineCount, onlineCount } from '../lib/cameras';
import { baliCameras, baliCategories, baliCategoryIcon } from '../lib/cameras-bali';

const cats = categories();
const baliCats = baliCategories();
const live = onlineCount();
const off = offlineCount();
const baliCount = baliCameras.length;
const baliOff = baliCameras.filter((c) => c.status === 'offline').length;
const current = Astro.url.pathname + Astro.url.search;

function isActive(href: string): boolean {
  if (href === '/') return current === '/';
  return current === href;
}
---

<nav class="px-2 pb-4">
  <a href="/" data-nav class={`sb-link ${isActive('/') ? 'active' : ''}`}>
    <Icon name="home" class="h-6 w-6 shrink-0" />
    <span class="sb-label">Beranda</span>
  </a>
  <a href="/?s=live" data-nav class={`sb-link ${isActive('/?s=live') ? 'active' : ''}`}>
    <Icon name="broadcast" class="h-6 w-6 shrink-0" />
    <span class="sb-label flex-1">CCTV Denpasar</span>
    <span class="sb-count text-xs text-dim">{live}</span>
  </a>
  <a href="/bali" data-nav class={`sb-link ${isActive('/bali') ? 'active' : ''}`}>
    <Icon name="tv" class="h-6 w-6 shrink-0" />
    <span class="sb-label flex-1">CCTV Bali</span>
    <span class="sb-count text-xs text-dim">{baliCount}</span>
  </a>
  <a href="/peta" data-nav class={`sb-link ${isActive('/peta') ? 'active' : ''}`}>
    <Icon name="map" class="h-6 w-6 shrink-0" />
    <span class="sb-label">Peta Lokasi</span>
  </a>

  <!-- Kamera Offline: klik untuk membuka 2 kartu (Denpasar / Bali) -->
  <div>
    <button type="button" data-offline-toggle class="sb-link w-full" aria-expanded="false" aria-controls="offline-panel">
      <Icon name="warning" class="h-6 w-6 shrink-0" />
      <span class="sb-label flex-1">Kamera Offline</span>
      <Icon name="chevron-right" class="offline-chev h-4 w-4 shrink-0 text-dim transition-transform" />
    </button>
    <div id="offline-panel" class="hidden space-y-2 px-2 pt-2">
      <a
        href="/?s=offline"
        data-nav
        class={`group block rounded-xl border bg-ink2 p-3 transition-colors hover:bg-ink3 ${isActive('/?s=offline') ? 'border-brand/50' : 'border-ink5/60'}`}
      >
        <div class="flex items-start justify-between gap-2">
          <span class="grid h-9 w-9 shrink-0 place-items-center rounded-lg bg-ink3 text-snow">
            <Icon name="pin" class="h-5 w-5" />
          </span>
          <span class="rounded-full bg-ink3 px-2 py-0.5 text-[11px] font-semibold text-dim">{off} kamera</span>
        </div>
        <h3 class="mt-2 text-sm font-bold">Offline Denpasar</h3>
        <p class="mt-0.5 text-[11px] leading-relaxed text-dim">Kamera ATCS Kota Denpasar yang sedang tidak aktif.</p>
      </a>
      <a
        href="/bali?s=offline"
        data-nav
        class={`group block rounded-xl border bg-ink2 p-3 transition-colors hover:bg-ink3 ${isActive('/bali?s=offline') ? 'border-brand/50' : 'border-ink5/60'}`}
      >
        <div class="flex items-start justify-between gap-2">
          <span class="grid h-9 w-9 shrink-0 place-items-center rounded-lg bg-ink3 text-snow">
            <Icon name="tv" class="h-5 w-5" />
          </span>
          <span class="rounded-full bg-ink3 px-2 py-0.5 text-[11px] font-semibold text-dim">{baliOff} kamera</span>
        </div>
        <h3 class="mt-2 text-sm font-bold">Offline Bali</h3>
        <p class="mt-0.5 text-[11px] leading-relaxed text-dim">Kamera CCTV Bali di luar Denpasar yang sedang tidak aktif.</p>
      </a>
    </div>
  </div>

  <div class="mx-3 my-3 border-t border-ink5/60"></div>
  <button type="button" data-cats-toggle data-cats-panel="cats-dps" class="sb-link w-full" aria-expanded="true" aria-controls="cats-dps">
    <span class="sb-label flex-1 text-xs font-semibold uppercase tracking-wider text-dim">ATCS Denpasar</span>
    <Icon name="chevron-down" class="cats-chev h-4 w-4 shrink-0 text-dim transition-transform" />
  </button>
  <div id="cats-dps" class="space-y-0.5">
    {cats.map((c) => (
      <a href={`/?k=${encodeURIComponent(c.name)}`} data-nav class={`sb-link ${isActive(`/?k=${encodeURIComponent(c.name)}`) ? 'active' : ''}`}>
        <Icon name={categoryIcon(c.name)} class="h-6 w-6 shrink-0" />
        <span class="sb-label flex-1">{c.name}</span>
        <span class="sb-count text-xs text-dim">{c.count}</span>
      </a>
    ))}
  </div>

  <div class="mx-3 my-3 border-t border-ink5/60"></div>
  <button type="button" data-cats-toggle data-cats-panel="cats-bali" class="sb-link w-full" aria-expanded="false" aria-controls="cats-bali">
    <span class="sb-label flex-1 text-xs font-semibold uppercase tracking-wider text-dim">ATCS Bali</span>
    <Icon name="chevron-down" class="cats-chev h-4 w-4 shrink-0 text-dim transition-transform" />
  </button>
  <div id="cats-bali" class="hidden space-y-0.5">
    {baliCats.map((c) => (
      <a href={`/bali?k=${encodeURIComponent(c.name)}`} data-nav class={`sb-link ${isActive(`/bali?k=${encodeURIComponent(c.name)}`) ? 'active' : ''}`}>
        <Icon name={baliCategoryIcon(c.name)} class="h-6 w-6 shrink-0" />
        <span class="sb-label flex-1">{c.name}</span>
        <span class="sb-count text-xs text-dim">{c.count}</span>
      </a>
    ))}
  </div>

  <div class="mx-3 my-3 border-t border-ink5/60"></div>
  <!-- Toggle tema terang/gelap -->
  <button type="button" data-theme-toggle class="sb-link w-full" aria-label="Ganti tema terang/gelap">
    <Icon name="sun" class="theme-ico-sun hidden h-6 w-6 shrink-0" />
    <Icon name="moon" class="theme-ico-moon h-6 w-6 shrink-0" />
    <span class="theme-label sb-label flex-1">Mode Gelap</span>
  </button>
</nav>

<script>
  // ---------- Toggle tema terang/gelap (default: terang) ----------
  const themeBtns = Array.from(document.querySelectorAll<HTMLElement>('[data-theme-toggle]'));
  const themeRoot = document.documentElement;

  function applyTheme(theme: string) {
    themeRoot.setAttribute('data-theme', theme);
    const dark = theme === 'dark';
    themeBtns.forEach((b) => {
      b.querySelector('.theme-ico-sun')?.classList.toggle('hidden', !dark);
      b.querySelector('.theme-ico-moon')?.classList.toggle('hidden', dark);
      const lbl = b.querySelector('.theme-label');
      if (lbl) lbl.textContent = dark ? 'Mode Terang' : 'Mode Gelap';
    });
    try {
      localStorage.setItem('atcs-theme', theme);
    } catch {}
  }

  let theme = themeRoot.getAttribute('data-theme') === 'dark' ? 'dark' : 'light';
  applyTheme(theme);

  themeBtns.forEach((b) =>
    b.addEventListener('click', () => {
      theme = theme === 'dark' ? 'light' : 'dark';
      applyTheme(theme);
    })
  );

  // ---------- Kamera Offline: toggle 2 kartu (Denpasar / Bali) ----------
  const offToggle = document.querySelector<HTMLElement>('[data-offline-toggle]');
  const offPanel = document.getElementById('offline-panel');
  const offChev = offToggle?.querySelector('.offline-chev');

  function syncOfflineOpen() {
    if (!offToggle || !offPanel || !offChev) return;
    const open = !offPanel.classList.contains('hidden');
    offToggle.setAttribute('aria-expanded', String(open));
    offChev.style.transform = open ? 'rotate(90deg)' : '';
  }

  offToggle?.addEventListener('click', () => {
    offPanel?.classList.toggle('hidden');
    syncOfflineOpen();
  });

  // Buka panel jika sedang di halaman ?s=offline (agar menu terlihat aktif)
  if (/\?s=offline/.test(location.search) && offPanel) {
    offPanel.classList.remove('hidden');
    syncOfflineOpen();
  }

  // ---------- ATCS Denpasar / ATCS Bali: show-hide sub kategori ----------
  // Default: Denpasar terbuka, Bali tertutup. Status toggle disimpan di
  // localStorage ('atcs-cats') sehingga pilihan pengguna bertahan saat reload.
  const CATS_KEY = 'atcs-cats';
  const catsToggles = Array.from(document.querySelectorAll<HTMLElement>('[data-cats-toggle]'));

  function catsState(): Record<string, boolean> {
    try {
      const raw = localStorage.getItem(CATS_KEY);
      return raw ? JSON.parse(raw) : {};
    } catch {
      return {};
    }
  }

  function catsDefaultOpen(panelId: string): boolean {
    return panelId === 'cats-dps';
  }

  function syncCats(toggle: HTMLElement, open: boolean) {
    toggle.setAttribute('aria-expanded', String(open));
    const chev = toggle.querySelector('.cats-chev');
    if (chev) chev.style.transform = open ? 'rotate(0deg)' : 'rotate(-90deg)';
  }

  catsToggles.forEach((toggle) => {
    const panel = document.getElementById(toggle.dataset.catsPanel || '');
    if (!panel) return;
    const saved = catsState()[toggle.dataset.catsPanel || ''];
    // Terapkan state simpanan (default Denpasar terbuka, Bali tertutup)
    const open = saved !== undefined ? saved : catsDefaultOpen(toggle.dataset.catsPanel || '');
    panel.classList.toggle('hidden', !open);
    syncCats(toggle, open);
    toggle.addEventListener('click', () => {
      const nowOpen = panel.classList.toggle('hidden');
      syncCats(toggle, !nowOpen);
      const next = catsState();
      next[toggle.dataset.catsPanel || ''] = !nowOpen;
      try {
        localStorage.setItem(CATS_KEY, JSON.stringify(next));
      } catch {}
    });
  });
</script>
