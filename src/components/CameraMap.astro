---
import 'leaflet/dist/leaflet.css';
import Icon from './Icon.astro';

interface Props {
  cam: string;
  namaAlias: string;
  lat: number | null;
  lon: number | null;
  kategori: string;
}

const { namaAlias, lat, lon, kategori } = Astro.props;
const hasCoords = lat != null && lon != null && !Number.isNaN(lat) && !Number.isNaN(lon);
const googleUrl = hasCoords ? `https://www.google.com/maps/search/?api=1&query=${lat},${lon}` : '';
---

{hasCoords && (
  <div class="mt-4 border-t border-ink5/50 pt-3">
    <button
      id="btn-map-toggle"
      type="button"
      class="group flex items-center gap-2 rounded-full border border-ink5 bg-ink3 px-3.5 py-1.5 text-xs font-semibold text-snow transition-colors hover:border-brand/60 hover:bg-ink4"
      aria-expanded="false"
      aria-controls="map-wrap"
    >
      <Icon name="pin" class="h-4 w-4 text-brand" />
      <span id="map-toggle-label">Lihat Lokasi di Peta</span>
    </button>

    <div id="map-wrap" class="hidden">
      <div
        id="camera-map"
        class="relative z-0 mt-3 h-[300px] w-full overflow-hidden rounded-xl border border-ink5/60 sm:h-[340px]"
        data-lat={lat}
        data-lon={lon}
        data-nama={namaAlias}
        data-kategori={kategori}
        data-google={googleUrl}
      ></div>
      <p class="mt-2 text-[11px] text-dim">
        Peta: OpenStreetMap © kontributor & CARTO · geser untuk menjelajah, gunakan +/− untuk zoom
      </p>
    </div>
  </div>
)}

<style is:global>
  .leaflet-container {
    /* Latar peta ikut tema (terlihat saat tile masih dimuat) */
    background: var(--color-ink2);
    font-family: inherit;
  }
  .leaflet-popup-content-wrapper,
  .leaflet-popup-tip {
    background: var(--color-ink3);
    color: var(--color-snow);
    border: 1px solid var(--color-ink5);
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.4);
  }
  .leaflet-popup-content-wrapper {
    border-radius: 10px;
  }
  .leaflet-popup-content {
    margin: 10px 14px;
  }
  .leaflet-control-zoom a {
    background: var(--color-ink3) !important;
    color: var(--color-snow) !important;
    border-color: var(--color-ink5) !important;
  }
  .leaflet-control-zoom a:hover {
    background: var(--color-ink4) !important;
  }
  .leaflet-control-attribution {
    background: var(--color-ink2) !important;
    color: var(--color-dim) !important;
    font-size: 10px !important;
  }
  .leaflet-control-attribution a {
    color: var(--color-dim) !important;
  }
  .cm-divicon {
    background: transparent;
    border: none;
  }
  .cm-pin {
    position: relative;
    color: #ff0000;
    filter: drop-shadow(0 2px 6px rgba(255, 0, 0, 0.55));
  }
  .cm-pin svg {
    display: block;
  }
  .cm-ping {
    position: absolute;
    left: 50%;
    top: 44%;
    width: 26px;
    height: 26px;
    margin: -13px 0 0 -13px;
    border-radius: 9999px;
    background: rgba(255, 0, 0, 0.45);
    animation: cm-ping 1.8s cubic-bezier(0, 0, 0.2, 1) infinite;
    pointer-events: none;
  }
  @keyframes cm-ping {
    0% {
      transform: scale(0.45);
      opacity: 0.9;
    }
    80%,
    100% {
      transform: scale(1.9);
      opacity: 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .cm-ping {
      animation: none;
      display: none;
    }
  }
</style>

<script>
  const btnToggle = document.getElementById('btn-map-toggle') as HTMLButtonElement | null;
  const btnCoords = document.getElementById('btn-coords') as HTMLButtonElement | null;
  const wrap = document.getElementById('map-wrap') as HTMLElement | null;
  const el = document.getElementById('camera-map') as HTMLElement | null;

  if (btnToggle && wrap && el) {
    const label = document.getElementById('map-toggle-label') as HTMLElement | null;
    const lat = Number(el.dataset.lat);
    const lon = Number(el.dataset.lon);
    const nama = el.dataset.nama || '';
    const kategori = el.dataset.kategori || '';
    const googleUrl = el.dataset.google || '';

    let map: any = null;
    let tileLayer: any = null;
    let ready: Promise<void> | null = null;

    // Vite kadang menginvalidasi cache deps (saat install/build) sehingga module Leaflet
    // sempat gagal dimuat (504) — coba ulang beberapa kali sebelum menyerah.
    async function loadLeaflet(): Promise<any> {
      let lastErr: any = null;
      for (let i = 0; i < 3; i++) {
        try {
          return await import('leaflet');
        } catch (e) {
          lastErr = e;
          if (i < 2) await new Promise((r) => setTimeout(r, 1500));
        }
      }
      throw lastErr;
    }

    // Tile peta dinamis mengikuti tema (gelap/terang)
    const isDarkTheme = () => document.documentElement.getAttribute('data-theme') === 'dark';
    const tileUrl = (dark: boolean) =>
      dark
        ? 'https://{s}.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}{r}.png'
        : 'https://{s}.basemaps.cartocdn.com/light_all/{z}/{x}/{y}{r}.png';

    // Saat tema berubah, ganti tile peta secara langsung (tanpa buka ulang peta)
    const themeObserver = new MutationObserver(() => {
      if (tileLayer) tileLayer.setUrl(tileUrl(isDarkTheme()));
    });
    themeObserver.observe(document.documentElement, {
      attributes: true,
      attributeFilter: ['data-theme'],
    });

    async function initMap() {
      if (!ready) {
        ready = (async () => {
          let L: any;
          try {
            L = await loadLeaflet();
          } catch {
            // Beri tahu pengguna alih-alih kotak peta kosong yang membingungkan
            ready = null; // izinkan coba lagi saat klik berikutnya
            if (el)
              el.innerHTML =
                '<div class="flex h-full items-center justify-center p-4 text-center text-xs text-dim">' +
                'Peta gagal dimuat — klik “Lihat Lokasi di Peta” sekali lagi untuk mencoba.</div>';
            return;
          }
          map = L.map(el, {
            center: [lat, lon],
            zoom: 14,
            zoomControl: true,
            scrollWheelZoom: false,
            attributionControl: true,
          });
          tileLayer = L.tileLayer(tileUrl(isDarkTheme()), {
            attribution:
              '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> &copy; <a href="https://carto.com/attributions">CARTO</a>',
            subdomains: 'abcd',
            maxZoom: 19,
          }).addTo(map);

          const icon = L.divIcon({
            className: 'cm-divicon',
            html:
              '<div class="cm-pin">' +
              '<svg viewBox="0 0 24 24" width="36" height="36" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">' +
              '<path d="M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0"/>' +
              '<circle cx="12" cy="10" r="3"/>' +
              '</svg>' +
              '<span class="cm-ping"></span>' +
              '</div>',
            iconSize: [36, 36],
            iconAnchor: [18, 34],
            popupAnchor: [0, -34],
          });

          L.marker([lat, lon], { icon })
            .addTo(map)
            .bindPopup(
              '<div style="min-width:170px">' +
                `<p style="margin:0;font-weight:700;font-size:13px">${nama}</p>` +
                `<p style="margin:2px 0 6px;font-size:11px;color:var(--color-dim)">${kategori} &middot; ${lat.toFixed(5)}, ${lon.toFixed(5)}</p>` +
                `<a href="${googleUrl}" target="_blank" rel="noreferrer" style="font-size:12px;color:var(--color-brand2);font-weight:600;text-decoration:none">Buka di Google Maps ↗</a>` +
                '</div>'
            );
        })();
      }
      try {
        await ready;
        // Pastikan peta mengukur ulang setelah container terlihat (fix tile kosong)
        window.setTimeout(() => map?.invalidateSize(), 80);
      } catch {
        /* gagal setelah retry — pesan sudah ditampilkan di initMap */
      }
    }

    function toggle(forceOpen?: boolean) {
      const isOpen = !wrap.classList.contains('hidden');
      const willOpen = forceOpen ?? !isOpen;
      if (willOpen) {
        wrap.classList.remove('hidden');
        if (label) label.textContent = 'Sembunyikan Peta';
        btnToggle?.setAttribute('aria-expanded', 'true');
        initMap(); // invalidateSize dijalankan di dalam initMap setelah sukses
      } else {
        wrap.classList.add('hidden');
        if (label) label.textContent = 'Lihat Lokasi di Peta';
        btnToggle?.setAttribute('aria-expanded', 'false');
      }
    }

    btnToggle.addEventListener('click', () => toggle());
    btnCoords?.addEventListener('click', () => toggle());
  }
</script>
