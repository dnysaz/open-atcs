---
import SidebarItems from './SidebarItems.astro';
---

<!-- Sidebar desktop (bisa collapse jadi ikon saja) -->
<aside id="sidebar" class="fixed bottom-0 left-0 top-14 z-30 hidden w-60 overflow-y-auto bg-ink px-2 py-4 lg:block">
  <SidebarItems />
</aside>

<!-- Drawer mobile -->
<div id="drawer" class="pointer-events-none fixed inset-0 z-[60] lg:hidden">
  <div id="drawer-backdrop" class="pointer-events-none absolute inset-0 bg-black/60 opacity-0"></div>
  <div id="drawer-panel" class="absolute bottom-0 left-0 top-0 w-72 -translate-x-full overflow-y-auto bg-ink shadow-2xl">
    <div class="flex h-14 items-center justify-between border-b border-ink5/60 px-4">
      <a href="/" class="flex items-center gap-2">
        <span class="grid h-8 w-8 place-items-center rounded-lg bg-brand">
          <svg viewBox="0 0 24 24" class="ml-0.5 h-5 w-5 text-white" fill="currentColor"><path d="M8 5.14v14l11-7z" /></svg>
        </span>
        <span class="text-lg font-bold tracking-tight">ATCS<span class="text-dim">TV</span></span>
      </a>
      <button id="drawer-close" class="grid h-10 w-10 place-items-center rounded-full hover:bg-ink4" aria-label="Tutup menu">
        <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
      </button>
    </div>
    <div class="pt-4">
      <SidebarItems />
    </div>
  </div>
</div>
