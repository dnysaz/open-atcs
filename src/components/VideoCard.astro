---
import Icon from './Icon.astro';
import { hashHue, searchText, typeLabel } from '../lib/cameras';
import type { Camera } from '../lib/cameras';

interface Props {
  camera: Camera;
  variant?: 'normal' | 'compact';
}

const { camera, variant = 'normal' } = Astro.props;
const hue = hashHue(camera.cam);
const gradient = `background:linear-gradient(135deg,hsl(${hue} 45% 22%),hsl(${(hue + 45) % 360} 45% 12%))`;
const online = camera.status === 'ok';
const search = searchText(camera);
---

{
  variant === 'normal' ? (
    <a
      href={`/watch/${camera.cam}`}
      data-cam-card
      data-search={search}
      data-kat={camera.kategori}
      data-status={camera.status}
      class="lazy-card group block"
    >
      <div class="relative aspect-video overflow-hidden rounded-xl" style={gradient}>
        <div class="absolute inset-0 grid place-items-center opacity-60">
          <Icon name="camera" class="h-10 w-10 text-white/50" />
        </div>
        <img
          src={`/thumbs/${camera.cam}.jpg`}
          alt={camera.namaAlias}
          loading="lazy"
          decoding="async"
          class="absolute inset-0 h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
          onerror="this.remove()"
        />
        <div class="absolute left-2 top-2">
          {online ? (
            <span class="live-pill">
              <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-white"></span>
              LIVE
            </span>
          ) : (
            <span class="flex items-center gap-1 rounded bg-black/70 px-1.5 py-0.5 text-[11px] font-bold text-white/80">
              <Icon name="warning" class="h-3 w-3 text-yellow-500" />
              OFFLINE
            </span>
          )}
        </div>
        <span class="absolute right-2 top-2 rounded bg-black/60 px-1.5 py-0.5 text-[10px] font-semibold uppercase tracking-wider text-white/80">
          {typeLabel(camera)}
        </span>
        <span class="absolute bottom-2 left-2 flex items-center gap-1 rounded bg-black/60 px-1.5 py-0.5 text-[10px] font-medium text-white/90">
          <Icon name="pin" class="h-3 w-3" />
          {camera.kategori}
        </span>
      </div>
      <div class="mt-3 flex gap-3">
        <div class="grid h-9 w-9 shrink-0 place-items-center rounded-full ring-1 ring-ink5/60" style={`background:hsl(${hue} 40% 30%)`}>
          <Icon name="camera" class="h-4 w-4 text-white/80" />
        </div>
        <div class="min-w-0 flex-1">
          <h3 class="line-clamp-2 text-sm font-medium leading-snug transition-colors group-hover:text-sky-400">
            {camera.namaAlias}
          </h3>
          <p class="mt-1 flex items-center gap-1 text-xs text-dim">
            <Icon name="pin" class="h-3 w-3 shrink-0" />
            <span class="truncate">{camera.namaLokasi}</span>
          </p>
          <p class="mt-0.5 text-xs text-dim">
            {typeLabel(camera)} • {camera.kategori}
          </p>
        </div>
      </div>
    </a>
  ) : (
    <a
      href={`/watch/${camera.cam}`}
      data-cam-card
      data-search={search}
      data-kat={camera.kategori}
      data-status={camera.status}
      class="lazy-card lazy-card-sm group flex gap-3"
    >
      <div class="relative aspect-video w-40 shrink-0 overflow-hidden rounded-lg sm:w-44" style={gradient}>
        <div class="absolute inset-0 grid place-items-center opacity-60">
          <Icon name="camera" class="h-8 w-8 text-white/50" />
        </div>
        <img
          src={`/thumbs/${camera.cam}.jpg`}
          alt={camera.namaAlias}
          loading="lazy"
          decoding="async"
          class="absolute inset-0 h-full w-full object-cover"
          onerror="this.remove()"
        />
        <div class="absolute left-1.5 top-1.5">
          {online ? (
            <span class="live-pill">
              <span class="h-1 w-1 animate-pulse rounded-full bg-white"></span>
              LIVE
            </span>
          ) : (
            <span class="flex items-center gap-1 rounded bg-black/70 px-1 py-0.5 text-[10px] font-bold text-white/80">
              <Icon name="warning" class="h-2.5 w-2.5 text-yellow-500" />
              OFFLINE
            </span>
          )}
        </div>
      </div>
      <div class="min-w-0 flex-1">
        <h3 class="line-clamp-2 text-sm font-medium leading-snug transition-colors group-hover:text-sky-400">
          {camera.namaAlias}
        </h3>
        <p class="mt-1 line-clamp-1 text-xs text-dim">{camera.namaLokasi}</p>
        <p class="mt-0.5 text-xs text-dim">
          {typeLabel(camera)} • {camera.kategori}
        </p>
      </div>
    </a>
  )
}
